# ─────────────────────────────────────────────────────────────
# Конфигурация локального AI-бота. Скопируй файл в .env
# и правь значения. Сам .env в репозиторий не коммитится.
# ─────────────────────────────────────────────────────────────

# Провайдер: ollama | ollama-light | openrouter | deepseek | proxyapi
AI_PROVIDER=ollama

# Ollama — полностью локально и бесплатно, ключ не нужен.
# Установи: https://ollama.com/download
# Скачай модель: ollama pull qwen3.5:latest
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen3.5:latest

# ─────────────────────────────────────────────────────────────
# Альтернативы: раскомментируй нужный блок вместо верхнего
# ─────────────────────────────────────────────────────────────

# OpenRouter — бесплатные модели (в названии есть :free),
# нужен бесплатный API-ключ: https://openrouter.ai/keys
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...
# AI_MODEL=deepseek/deepseek-chat-v3-0324:free

# DeepSeek
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=deepseek-chat

# ProxyAPI — провайдер из урока
# AI_PROVIDER=proxyapi
# AI_BASE_URL=https://api.proxyapi.ru/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4.1-mini

# ─────────────────────────────────────────────────────────────
# Поведение бота
# ─────────────────────────────────────────────────────────────

# Роль модели. Меняется без правки кода.
SYSTEM_PROMPT=Ты — локальный AI-ассистент, который помогает с вопросами, кодом и текстами. Отвечай на русском языке, по делу и без воды. Если вопрос короткий — отвечай коротко. Если не хватает данных, задай уточняющий вопрос вместо догадок. Честно говори, когда чего-то не знаешь.

# Креативность: 0 — строго по фактам, 1 — свободнее
TEMPERATURE=0.7

# Ограничение длины ответа в токенах
MAX_TOKENS=800

# Сколько последних реплик помнить (контекст диалога)
HISTORY_LIMIT=10

# Таймаут запроса к модели, секунды
TIMEOUT=120

# Печатать ответ по мере генерации
STREAM=true

# Показывать время ответа и расход токенов
SHOW_TIMING=true

# Писать диалог в файл — из него делается скриншот для ДЗ
SAVE_TRANSCRIPT=true
TRANSCRIPT_PATH=logs/dialog.md
